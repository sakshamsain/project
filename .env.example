# Copy to an env file OUTSIDE the repo and point FINN_ENV_FILE at it for local runs.
# Production values live in Modal (workers) and Vercel (web) secret stores.

FINN_ENV=dev

# Postgres (Neon, pooled connection string)
DATABASE_URL=

# Models and search
GEMINI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Object storage for PDFs (Neon's S3-compatible storage)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=finn-docs

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Errors
SENTRY_DSN=
